# Copy this file to .env for local use. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit the real .env file.

# Email provider: set ONE of these. Resend is used if both are set.
RESEND_API_KEY=
SENDGRID_API_KEY=

# Sender address. Its domain must be verified with your provider (e.g. incubr.com).
MAIL_FROM=products@incubr.com
MAIL_FROM_NAME=Incubr website

# Where booking requests are delivered. Separate several addresses with commas.
CONTACT_TO_EMAIL=products@incubr.com

# Send the visitor a "we've received your request" email. Set to false to turn off.
SEND_CONFIRMATION_EMAIL=true
